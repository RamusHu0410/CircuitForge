# Copy to .env and adjust. Never commit .env or real API keys.

APP_NAME="KiCad AI Schematic Backend"
APP_ENV=development
DEBUG=false
API_PREFIX=/api

# Electrical Rules Check with KiCad's command-line tool.
ERC_ENABLED=true
# Leave empty to auto-detect (PATH, then the standard KiCad install location).
KICAD_CLI_PATH=
ERC_TIMEOUT_S=60

# Gemini: put GEMINI_API_KEY in env/gemini.env (git-ignored) or here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: let a language model read complex project descriptions (e.g. games with joysticks and LEDs).
# The prompt text is sent to the provider. Leave empty to use the built-in rules only.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_S=30

# Where POST /api/generate/save writes projects.
# Leave empty for ~/Documents/KiCad/ai_generated.
OUTPUT_DIR=

# Browser access for the CircuitForge web UI (comma-separated). The KiCad plugin is unaffected.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# KiCad's settings folder, to read your schematic color theme. Empty = auto-detect.
KICAD_SETTINGS_DIR=
