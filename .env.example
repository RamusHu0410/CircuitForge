# The CircuitForge service (kicad-ai-extension/backend). In dev, Vite proxies /api to it, so these can stay blank.
# Set them only to call a service on another host.
VITE_ENGINE_URL=
VITE_KICAD_BRIDGE_URL=

# Dev proxy target (read by vite.config.ts). Default: http://127.0.0.1:8765
CIRCUITFORGE_BACKEND=
